{
  "name": "cf-ai-waf-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Demo chat app for Cloudflare AI Security for Apps (Firewall for AI)",
  "scripts": {
    "dev:web": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b web/tsconfig.json && vite build",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.0.0"
  }
}
